{
  "name": "lumiverse-frontend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "test": "bun test --isolate",
    "test:slow": "bun test --isolate --path-ignore-patterns='' .slow.test",
    "dev": "bun run generate && vite",
    "dev:bundled": "bun run dev",
    "dev:unbundled": "bun run generate && LUMIVERSE_BUNDLED_DEV=0 vite",
    "generate": "bun run extract-props && bun run extract-css-vars && bun run generate:theme-reference",
    "extract-props": "bun run scripts/extract-props.ts",
    "extract-css-vars": "bun run scripts/extract-css-vars.ts",
    "typecheck": "bun run generate && tsc -b",
    "lint": "eslint .",
    "build": "bun run generate && bun run scripts/build-frontend.ts",
    "build:checked": "bun run generate && tsc -b && bun run scripts/build-frontend.ts",
    "build:import-map": "bun run build:checked",
    "build:legacy": "LUMIVERSE_CHUNK_IMPORT_MAP=0 LUMIVERSE_REACT_COMPILER=babel bun run build:checked",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall-bindings.cjs || true",
    "generate:theme-reference": "bun run scripts/generate-theme-reference.ts",
    "check:theme-reference": "bun run scripts/generate-theme-reference.ts --check"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@better-auth/oauth-provider": "1.7.14",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.41.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2",
    "better-auth": "1.7.14",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.2.0",
    "lucide-react": "^0.468.0",
    "lumiverse-spindle-types": "0.6.76",
    "marked": "^15.0.4",
    "motion": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^5.1.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.0.1",
    "oxc-transform-react": "0.154.0",
    "typescript": "^6.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "css-tree": "3.2.1"
  },
  "overrides": {
    "rolldown": "1.2.15",
    "lightningcss": "1.33.0"
  },
  "optionalDependencies": {
    "@oxc-transform-react/binding-android-arm64": "0.154.0",
    "@rolldown/binding-android-arm64": "1.2.15",
    "lightningcss-android-arm64": "1.33.0"
  },
  "patchedDependencies": {
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
  }
}
