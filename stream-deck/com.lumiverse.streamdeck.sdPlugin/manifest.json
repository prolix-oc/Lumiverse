{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Open Recent Chat",
      "UUID": "com.lumiverse.streamdeck.openrecent",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    },
    {
      "Name": "Open Character Chat",
      "UUID": "com.lumiverse.streamdeck.opencharacter",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/property-inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Browse Lumiverse",
      "UUID": "com.lumiverse.streamdeck.browser",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "middle",
          "FontSize": 11
        }
      ]
    },
    {
      "Name": "Lumiverse Browser Result",
      "UUID": "com.lumiverse.streamdeck.browserslot",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    },
    {
      "Name": "Lumiverse Browser Control",
      "UUID": "com.lumiverse.streamdeck.browsercontrol",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ]
    }
  ],
  "Author": "Lumiverse",
  "Category": "Lumiverse",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.cjs",
  "Description": "Open recent Lumiverse character chats from Stream Deck.",
  "Name": "Lumiverse",
  "Icon": "imgs/plugin",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "PropertyInspectorPath": "ui/property-inspector.html",
  "Profiles": [
    {
      "Name": "profiles/Lumiverse Browser",
      "DeviceType": 0,
      "Readonly": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/Lumiverse Browser Mini",
      "DeviceType": 1,
      "Readonly": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/Lumiverse Browser XL",
      "DeviceType": 2,
      "Readonly": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/Lumiverse Browser Plus",
      "DeviceType": 7,
      "Readonly": true,
      "AutoInstall": false
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "UUID": "com.lumiverse.streamdeck",
  "Version": "0.1.0.12"
}